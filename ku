#!/bin/bash
SCRIPT_NAME=$(basename "$0")
KUBE_HOME="${KUBE_HOME:=$HOME/.kube}"
KUBE_CONFIGS_DIR="${KUBE_CONFIGS_DIR:=$KUBE_HOME/configs}"
KU_CONF="${KU_CONF:=$KUBE_HOME/ku.conf}"

#
# list kubeconfig files
#
function list() {
    if [[ -d "$KUBE_CONFIGS_DIR" ]]; then
        echo 'available kubeconfig files:'
        echo "$KUBE_CONFIGS_DIR"
        pushd "$KUBE_CONFIGS_DIR" > /dev/null
        ls -l
        popd > /dev/null
        echo
    fi
    if [[ -d "$KUBE_HOME" ]]; then
        echo 'current kubeconfig file:'
        echo "$KUBE_HOME"
        pushd "$KUBE_HOME" > /dev/null
        ls -l config
        popd > /dev/null
    fi
}

#
# select a kubeconfig
#
function selectconfig() {
    selectconfig_parse_opts "$@"
    [[ ! -f "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" ]] && echo "[ERROR] kubeconfig not found: $KUBE_CONFIGS_DIR/$KUBE_CONFIG" && exit 1
    cp "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" "$KUBE_HOME/config"
}

function selectconfig_parse_opts() {
    if [[ $# = 0 ]]; then
        selectconfig_help
    fi
    if [[ "$1" = '-h' ]]; then
        selectconfig_help
    fi
    KUBE_CONFIG="$1"
}

function selectconfig_help() {
    local command='select'
    printf 'Usage: %s %s <kubeconfig> [-h]\n' "$SCRIPT_NAME" $command
    printf '\t%s\n' '-h: Prints help'
    exit 0
}

#
# exec k9s in a given context
#
function exec_k9s() {
    exec_k9s_parse_opts "$@"
    [[ ! -f "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" ]] && echo "[ERROR] kubeconfig not found: $KUBE_CONFIGS_DIR/$KUBE_CONFIG" && exit 1
    k9s --kubeconfig "$KUBE_CONFIGS_DIR/$KUBE_CONFIG"
}

function exec_k9s_parse_opts() {
    if [[ $# = 0 ]]; then
        use_exec_k9s
    fi
    if [[ "$1" = '-h' ]]; then
        use_exec_k9s
    fi
    KUBE_CONFIG="$1"
}

function use_exec_k9s() {
    local command='k9s'
    printf 'Usage: %s %s <context> [-h]\n' "$SCRIPT_NAME" $command
    printf '\t%s\n' '-h: Prints help'
    exit 0
}

#
# exec a command with a given kubeconfig
#
function exec_cmd() {
    exec_cmd_parse_opts "$@"
    [[ ! -f "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" ]] && echo "[ERROR] kubeconfig not found: $KUBE_CONFIGS_DIR/$KUBE_CONFIG" && exit 1
    KUBECONFIG="$KUBE_CONFIGS_DIR/$KUBE_CONFIG" "${CMD[@]}"
}

function exec_cmd_parse_opts() {
    if [[ $# = 0 ]]; then
        exec_cmd_help
    fi
    if [[ "$1" = '-h' ]]; then
        exec_cmd_help
    fi
    KUBE_CONFIG="$1"
    shift
    [[ "$1" = '--' ]] && shift
    CMD=("$@")
    [[ ${#CMD[@]} = 0 ]] && exec_cmd_help
}

function exec_cmd_help() {
    local command='exec'
    printf 'Usage: %s %s <kubeconfig> -- <command> [args...]\n' "$SCRIPT_NAME" $command
    printf '\t%s\n' '-h: Prints help'
    exit 0
}

#
# spawn a subshell with a given kubeconfig
#
function exec_shell() {
    exec_shell_parse_opts "$@"
    [[ ! -f "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" ]] && echo "[ERROR] kubeconfig not found: $KUBE_CONFIGS_DIR/$KUBE_CONFIG" && exit 1
    KUBECONFIG="$KUBE_CONFIGS_DIR/$KUBE_CONFIG" $SHELL
}

function exec_shell_parse_opts() {
    if [[ $# = 0 ]]; then
        exec_shell_help
    fi
    if [[ "$1" = '-h' ]]; then
        exec_shell_help
    fi
    KUBE_CONFIG="$1"
}

function exec_shell_help() {
    local command='shell'
    printf 'Usage: %s %s <kubeconfig> [-h]\n' "$SCRIPT_NAME" $command
    printf '\t%s\n' '-h: Prints help'
    exit 0
}

#
# print the current kubeconfig path
#
function print_config_path() {
    local path
    if [[ -n "$KUBECONFIG" ]]; then
        path="$KUBECONFIG"
    elif [[ -f "$KUBE_HOME/config" ]]; then
        path="$KUBE_HOME/config"
    else
        path='[none]'
    fi
    printf '\033[1;97m%s\033[0m\n' "$path"
}

#
# print the current kubeconfig contents
#
function print_config() {
    local path
    if [[ -n "$KUBECONFIG" ]]; then
        path="$KUBECONFIG"
    elif [[ -f "$KUBE_HOME/config" ]]; then
        path="$KUBE_HOME/config"
    else
        path='[none]'
    fi
    if [[ "$path" == '[none]' ]]; then
        echo '[none]'
    else
        cat "$path"
    fi
}

#
# print the current kubeconfig path and contents
#
function print_config_all() {
    echo "Shell Level: $SHLVL"
    echo ---
    local path
    if [[ -n "$KUBECONFIG" ]]; then
        path="$KUBECONFIG"
    elif [[ -f "$KUBE_HOME/config" ]]; then
        path="$KUBE_HOME/config"
    else
        path='[none]'
    fi
    printf '\033[1;97m%s\033[0m\n' "$path"
    if [[ "$path" != '[none]' ]]; then
        echo ---
        cat "$path"
    fi
}

#
# copy current ~/.kube/config to ~/.kube/configs/<name>
#
function copyconfig() {
    [[ $# = 0 ]] && echo "Usage: $SCRIPT_NAME cp <name>" && exit 1
    mkdir -p "$KUBE_CONFIGS_DIR"
    cp "$KUBE_HOME/config" "$KUBE_CONFIGS_DIR/$1"
    echo "copied $KUBE_HOME/config -> $KUBE_CONFIGS_DIR/$1"
}

#
# import (move) a kubeconfig file to ~/.kube/configs/<name>
#
function import_config() {
    import_config_parse_opts "$@"
    local file
    file=$(import_config_find "$IMPORT_FILE")
    [[ -z "$file" ]] && echo "[ERROR] file not found: $IMPORT_FILE" && exit 1
    IMPORT_FILE="$file"
    ! grep -Eq '^kind:[[:space:]]*Config' "$IMPORT_FILE" && echo "[ERROR] not a kubeconfig: $IMPORT_FILE" && exit 1
    [[ -z "$KUBE_CONFIG" ]] && KUBE_CONFIG=$(import_config_name "$IMPORT_FILE")
    [[ -z "$KUBE_CONFIG" || "$KUBE_CONFIG" == */* ]] && echo "[ERROR] invalid kubeconfig name: '$KUBE_CONFIG'" && exit 1
    [[ -e "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" && "$FORCE" != true ]] && echo "[ERROR] kubeconfig already exists: $KUBE_CONFIGS_DIR/$KUBE_CONFIG (use -f to overwrite)" && exit 1
    mkdir -p "$KUBE_CONFIGS_DIR"
    mv -f "$IMPORT_FILE" "$KUBE_CONFIGS_DIR/$KUBE_CONFIG"
    chmod 600 "$KUBE_CONFIGS_DIR/$KUBE_CONFIG"
    echo "imported $IMPORT_FILE -> $KUBE_CONFIGS_DIR/$KUBE_CONFIG"
}

#
# find the file to import as given, or else in the directories of ku.conf
#
function import_config_find() {
    local keyword dir
    [[ -f "$1" ]] && echo "$1" && return
    [[ ! -f "$KU_CONF" ]] && return
    while read -r keyword dir || [[ -n "$keyword" ]]; do
        [[ "$keyword" != directory || -z "$dir" ]] && continue
        dir="${dir/#\~/$HOME}"
        [[ -f "$dir/$1" ]] && echo "$dir/$1" && return
    done < "$KU_CONF"
}

#
# derive the kubeconfig name from the file name using the prefix/suffix rules of ku.conf
#
function import_config_name() {
    local name keyword from to
    name=$(basename "$1")
    if [[ -f "$KU_CONF" ]]; then
        while read -r keyword from to || [[ -n "$keyword" ]]; do
            [[ -z "$from" ]] && continue
            case "$keyword" in
                prefix)
                    [[ "$name" == "$from"* ]] && name="$to${name#"$from"}"
                    ;;
                suffix)
                    [[ "$name" == *"$from" ]] && name="${name%"$from"}$to"
                    ;;
            esac
        done < "$KU_CONF"
    fi
    echo "$name"
}

function import_config_parse_opts() {
    local args=()
    FORCE=false
    for arg in "$@"; do
        case "$arg" in
            -f)
                FORCE=true
                ;;
            -*)
                import_config_help
                ;;
            *)
                args+=("$arg")
                ;;
        esac
    done
    [[ ${#args[@]} = 0 || ${#args[@]} -gt 2 ]] && import_config_help
    IMPORT_FILE="${args[0]}"
    KUBE_CONFIG="${args[1]}"
}

function import_config_help() {
    local command='import'
    printf 'Usage: %s %s <file> [name] [-f] [-h]\n' "$SCRIPT_NAME" $command
    printf '\t%s\n' '-f: Overwrite existing kubeconfig'
    printf '\t%s\n' '-h: Prints help'
    printf '%s\n' "If the file is not found, it is looked up in the directories of $KU_CONF"
    printf '%s\n' "The name defaults to the file name rewritten by the prefix/suffix rules of $KU_CONF"
    exit 0
}

#
# remove kubeconfig files
#
function remove() {
    remove_parse_opts "$@"
    local status=0
    for KUBE_CONFIG in "${KUBE_CONFIGS[@]}"; do
        if [[ ! -f "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" ]]; then
            echo "[ERROR] kubeconfig not found: $KUBE_CONFIGS_DIR/$KUBE_CONFIG"
            status=1
            continue
        fi
        rm "$KUBE_CONFIGS_DIR/$KUBE_CONFIG" && echo "removed $KUBE_CONFIGS_DIR/$KUBE_CONFIG" || status=1
    done
    exit $status
}

function remove_parse_opts() {
    if [[ $# = 0 ]]; then
        remove_help
    fi
    if [[ "$1" = '-h' ]]; then
        remove_help
    fi
    KUBE_CONFIGS=("$@")
}

function remove_help() {
    local command='remove'
    printf 'Usage: %s %s <kubeconfig>... [-h]\n' "$SCRIPT_NAME" $command
    printf '\t%s\n' '-h: Prints help'
    exit 0
}

function parse_command_line() {
    if [[ $# -eq 0 ]]; then
        help
    fi
    case "$1" in
        -h|--help)
            help
            ;;
        -h*)
            help
            ;;
        list|ls)
            list
            ;;
        select|s)
            shift
            selectconfig "$@"
            ;;
        k9s|9)
            shift
            exec_k9s "$@"
            ;;
        exec|x)
            shift
            exec_cmd "$@"
            ;;
        remove|rm)
            shift
            remove "$@"
            ;;
        shell|sh)
            shift
            exec_shell "$@"
            ;;
        cp|copy)
            shift
            copyconfig "$@"
            ;;
        import|i)
            shift
            import_config "$@"
            ;;
        print|p)
            print_config
            ;;
        printpath|pp)
            print_config_path
            ;;
        printall|pa)
            print_config_all
            ;;
        *)
            help
            ;;
    esac
}

function help() {
    printf 'Usage: %s <command> [-h]\n' "$SCRIPT_NAME"
    echo 'commands:'
    echo 'ls|list: list kubeconfig files'
    echo 's|select <kubeconfig>: select a kubeconfig file'
    echo '9|k9s <context>: exec k9s with the context of a kubeconfig file'
    echo 'x|exec <kubeconfig> -- <command>: execute a command with the kubeconfig'
    echo 'sh|shell <kubeconfig>: spawn a subshell with the kubeconfig isolated to this session'
    echo 'p|print: print the current kubeconfig contents'
    echo 'pp|printpath: print the current kubeconfig path'
    echo 'pa|printall: print the current kubeconfig path and contents'
    echo 'cp|copy <name>: copy current kubeconfig to configs/<name>'
    echo 'i|import <file> [name] [-f]: move a kubeconfig file to configs/<name>'
    echo 'rm|remove <kubeconfig>...: remove kubeconfig files'
    echo '-h: prints help'
    exit 0
}

parse_command_line "$@"
